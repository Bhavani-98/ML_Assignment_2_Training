# Raw UCI download / extraction.
# The large generated CSV and the zip stay out of Git, but the small raw
# .data file (and its docs) ARE committed so training works offline on any
# machine via `python src/prepare_data.py`.
_spam/*
!_spam/spambase.data
!_spam/spambase.names
!_spam/spambase.DOCUMENTATION
!_spam/spambase_full.csv
_spam.zip

# Python cruft
__pycache__/
*.pyc
*.pyo
.ipynb_checkpoints/
.venv/
venv/
env/

# Build / packaging
build/
dist/
*.egg-info/

# Tooling caches
.pytest_cache/
.mypy_cache/

# Editor
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db
